# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
HOST=localhost
NODE_ENV=development

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Obtener desde: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID_AQUI.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU_GOOGLE_CLIENT_SECRET_AQUI
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_WORKSPACE_DOMAIN=lasalle.edu.ar

# ─── Sesiones ─────────────────────────────────────────────────────────────────
# Genera un secret seguro: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiar-este-secret-por-uno-generado-aleatoriamente-minimo-32-chars
SESSION_NAME=fortigate_session
SESSION_SECURE=false
SESSION_MAX_AGE=86400000

# ─── Backend Python ────────────────────────────────────────────────────────────
PYTHON_API_URL=http://127.0.0.1:8000

# ─── Usuarios autorizados (separados por coma, sin espacios) ──────────────────
AUTHORIZED_EMAILS=usuario1@dominio.com,usuario2@dominio.com

# ─── Admins (subconjunto de AUTHORIZED_EMAILS) ────────────────────────────────
ADMIN_EMAILS=admin@dominio.com

# ─── Proxy (solo producción) ──────────────────────────────────────────────────
# TRUST_PROXY=true
